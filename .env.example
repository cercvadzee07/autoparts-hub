# ─────────────────────────────────────────────────────────────
# AutoParts Hub — environment variables
# Copy to .env.local and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (production data layer) ─────────────────────────
# Supabase Dashboard → Project Settings → API.
# Leave BOTH empty to run in local DEMO MODE (JSON file database in .data/).
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. It is safe in the browser because every
# table is protected by Row Level Security (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NOTE: the service-role key is NOT required by this app. Never put it in a
# NEXT_PUBLIC_ variable.

# ── Session signing (demo mode only) ─────────────────────────
# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Demo-mode admin login (ignored when Supabase is configured) ─
# Used only for local development without Supabase.
DEMO_ADMIN_EMAIL=admin@autoparts.local
DEMO_ADMIN_PASSWORD=demo-admin-2026
